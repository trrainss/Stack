# ---------------------------------------------------------------------------
# STACKLAB environment
# Copy this file to .env and fill in the values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database ---------------------------------------------------------------
# Local development on SQLite (no database server required). The build script
# picks the SQLite schema when the URL starts with file:.
DATABASE_URL="file:./dev.db"
#
# Production on Supabase (Project Settings -> Database -> Connection string).
# DATABASE_URL = "Transaction pooler" (port 6543) + pgbouncer params, used by
#                the app at runtime.
# DIRECT_URL   = "Session pooler" (port 5432) or "Direct connection", used only
#                by Prisma migrations. Keep it out of the client bundle.
#
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
#
# Any other PostgreSQL host also works; DIRECT_URL then falls back to
# DATABASE_URL.

# Application ------------------------------------------------------------
# Public origin, used for canonical URLs, sitemap and Open Graph.
APP_URL="http://localhost:3000"

# Secret used to sign session tokens and CSRF tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# First administrator (used only by `npm run admin:create`) -------------
ADMIN_EMAIL=""
# If empty, the script generates a strong password and prints it once.
ADMIN_PASSWORD=""

# Telegram notifications (optional) -------------------------------------
# Create a separate bot with @BotFather, then send it any message and read
# the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Email notifications (optional, SMTP) ----------------------------------
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""
# Use TLS (true for port 465, false for STARTTLS on 587)
EMAIL_SERVER_SECURE="false"
